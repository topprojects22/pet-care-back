generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String?
  phone        String         @default("")
  password     String
  avatarPath   String         @default("uploads/default-avatar.png") @map("avatar_path")
  roleId       Int?           @map("role_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  role         Role?          @relation(fields: [roleId], references: [id])
  pets         Pet[]
  notification Notification[]
}

model Pet {
  id                 Int                  @id @default(autoincrement())
  name               String
  userId             Int?                 @map("user_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  user               User?                @relation(fields: [userId], references: [id])
  petPassport        PetPassport?
  petCard            PetCard?
  admissionVetClinic AdmissionVetClinic[]
  animalType         AnimalType?          @relation(fields: [animalTypeId], references: [id])
  animalTypeId       Int?
  notification       Notification[]
  PetOnNotification  PetOnNotification[]
}

model PetPassport {
  id        Int      @id @default(autoincrement())
  petId     Int      @unique
  chip      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pet       Pet      @relation(fields: [petId], references: [id])
}

model PetCard {
  id         Int      @id @default(autoincrement())
  petId      Int      @unique
  status     String
  health     String
  vaccine    String
  totalSpent Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  pet        Pet      @relation(fields: [petId], references: [id])
}

model AnimalType {
  id          Int           @id @default(autoincrement())
  name        String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  animalBreed AnimalBreed[]
  pets        Pet[]
}

model AnimalBreed {
  id           Int         @id @default(autoincrement())
  name         String // TODO вернуть уникальность
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  animalTypeId Int // TODO вернуть уникальность
  animalType   AnimalType? @relation(fields: [animalTypeId], references: [id])
}

model Clinic {
  id                 Int                  @id @default(autoincrement())
  name               String
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  admissionVetClinic AdmissionVetClinic[]
  service            Service[]
}

model AdmissionVetClinic {
  id            Int      @id @default(autoincrement())
  petId         Int
  clinicId      Int
  procedure     String
  description   String
  diagnosis     String
  recomendation String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  pet           Pet      @relation(fields: [petId], references: [id])
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
}

model Service {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  recomendation String
  price         Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  clinicId      Int // TODO вернуть уникальность
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String // TODO вернуть уникальность
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User[]
}

model Notification {
  id                Int                 @id @default(autoincrement())
  name              String
  description       String
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  expiriedAt        DateTime?
  type              NotificationType
  userId            Int
  user              User                @relation(fields: [userId], references: [id])
  pets              Pet[]
  PetOnNotification PetOnNotification[]
}

enum NotificationType {
  hight
  medium
  low
}

model PetOnNotification {
  pet            Pet          @relation(fields: [petId], references: [id])
  petId          Int
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId Int
  assignedAt     DateTime     @default(now())
  assignedBy     String

  @@id([petId, notificationId])
}
