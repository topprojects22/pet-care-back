generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String?
  lastName         String?   @map("last_name")
  middleName       String?   @map("middle_name")
  phone            String    @default("")
  password         String
  avatarPath       String    @default("uploads/default-avatar.png") @map("avatar_path")
  roleId           Int?      @map("role_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")
  isVerified       Boolean   @default(false) @map("is_verified")
  birthDate        DateTime? @map("birth_date")
  address          String?
  emergencyContact String?   @map("emergency_contact")
  insuranceNumber  String?   @map("insurance_number")
  preferences      Json?
  socialMedia      Json?     @map("social_media")
  isSubscribed     Boolean   @default(true) @map("is_subscribed")
  lastActivityAt   DateTime? @map("last_activity_at")

  role               Role?                @relation(fields: [roleId], references: [id])
  pets               Pet[]
  notification       Notification[]
  preferredClinics   Clinic[]             @relation("UserPreferredClinics")
  payments           Payment[]
  reviews            Review[]
  petBoarding        PetBoarding[]
  petBoardingBooking PetBoardingBooking[]
  petBoardingReview  PetBoardingReview[]
  communityPost      CommunityPost[]
  postLike           PostLike[]
  postComment        PostComment[]
  eventParticipation EventParticipation[]

  shelter           Shelter[]
  emailVerification EmailVerification[]
  passwordReset     PasswordReset[]
  adoptionRequests  AdoptionRequest[]
  donations         Donation[]
  paymentSessions   PaymentSession[]

  @@index([roleId])
  @@index([createdAt])
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  verifiedAt DateTime? @map("verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Pet {
  id              Int        @id @default(autoincrement())
  avatarPath      String?    @map("avatar_path") // для аватара питомца
  name            String
  userId          Int?       @map("user_id")
  birthDate       DateTime?  @map("birth_date")
  gender          PetGender?
  weight          Float?
  color           String?
  isSterilized    Boolean    @default(false) @map("is_sterilized")
  deathDate       DateTime?  @map("death_date")
  microchipDate   DateTime?  @map("microchip_date")
  pedigreeNumber  String?    @map("pedigree_number")
  insurancePolicy String?    @map("insurance_policy")
  foodPreferences String?    @map("food_preferences")
  behaviorNotes   String?    @map("behavior_notes")
  trainingLevel   String?    @map("training_level")
  favoriteToys    String?    @map("favorite_toys")
  dailyRoutine    String?    @map("daily_routine")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user               User?                @relation(fields: [userId], references: [id])
  petPassport        PetPassport?
  petCard            PetCard?
  admissionVetClinic AdmissionVetClinic[]
  animalType         AnimalType?          @relation(fields: [animalTypeId], references: [id])
  animalTypeId       Int?
  petOnNotification  PetOnNotification[]
  medications        Medication[]
  vaccinations       Vaccination[]
  photos             PetPhoto[]
  healthMetrics      HealthMetric[]
  groomingRecords    GroomingRecord[]
  petBoardingBooking PetBoardingBooking[]
  petJournalEntry    PetJournalEntry[]
  eventParticipation EventParticipation[]

  @@index([userId])
  @@index([animalTypeId])
  @@index([createdAt])
  @@index([userId, createdAt]) // Составной индекс для частых запросов списка питомцев пользователя
}

enum PetGender {
  MALE
  FEMALE
  OTHER
}

model PetPassport {
  id                  Int       @id @default(autoincrement())
  petId               Int       @unique
  chip                Int
  chipInstallDate     DateTime? @map("chip_install_date")
  breedId             Int?
  tattooNumber        String?   @map("tattoo_number")
  specialMarks        String?   @map("special_marks")
  issuingOrganization String?   @map("issuing_organization")
  registrationNumber  String?   @map("registration_number")
  vaccinationHistory  Json?     @map("vaccination_history")
  ownerSignature      String?   @map("owner_signature")
  vetSignature        String?   @map("vet_signature")
  qrCode              String?   @map("qr_code")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  pet   Pet          @relation(fields: [petId], references: [id])
  breed AnimalBreed? @relation(fields: [breedId], references: [id])
}

model PetCard {
  id              Int       @id @default(autoincrement())
  petId           Int       @unique
  status          String
  health          String
  vaccine         String
  totalSpent      Int       @map("total_spent")
  lastVetVisit    DateTime? @map("last_vet_visit")
  nextVetVisit    DateTime? @map("next_vet_visit")
  allergies       String?
  chronicDiseases String?   @map("chronic_diseases")
  favoriteFood    String?   @map("favorite_food")
  bloodType       String?   @map("blood_type")
  dentalRecords   String?   @map("dental_records")
  parasiteControl String?   @map("parasite_control")
  spayNeuterInfo  String?   @map("spay_neuter_info")
  microchipInfo   String?   @map("microchip_info")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id])
}

model AnimalType {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  animalBreed   AnimalBreed[]
  pets          Pet[]
  shelterAnimal ShelterAnimal[]
}

model AnimalBreed {
  id             Int        @id @default(autoincrement())
  name           String
  description    String?
  sizeCategory   BreedSize? @map("size_category")
  lifeExpectancy Int?       @map("life_expectancy")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  animalTypeId   Int        @map("animal_type_id")

  animalType    AnimalType?     @relation(fields: [animalTypeId], references: [id])
  petPassport   PetPassport[]
  shelterAnimal ShelterAnimal[]
}

enum BreedSize {
  SMALL
  MEDIUM
  LARGE
}

model Clinic {
  id               Int       @id @default(autoincrement())
  name             String
  address          String
  phone            String
  email            String?
  website          String?
  workingHours     String?   @map("working_hours")
  geoCoordinates   String?   @map("geo_coordinates")
  rating           Float?
  photos           String[]
  licenseNumber    String?   @map("license_number")
  foundingDate     DateTime? @map("founding_date")
  specialties      String[]
  equipment        String[]
  parkingAvailable Boolean   @default(false) @map("parking_available")
  emergencyService Boolean   @default(false) @map("emergency_service")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  admissionVetClinic AdmissionVetClinic[]
  service            Service[]
  preferredBy        User[]               @relation("UserPreferredClinics")
  vaccination        Vaccination[]
  staff              StaffMember[]
  reviews            Review[]
}

model AdmissionVetClinic {
  id            Int       @id @default(autoincrement())
  petId         Int       @map("pet_id")
  clinicId      Int       @map("clinic_id")
  procedure     String
  description   String
  diagnosis     String
  recomendation String
  visitDate     DateTime  @map("visit_date")
  nextVisitDate DateTime? @map("next_visit_date")
  doctorName    String?   @map("doctor_name")
  medications   String?
  cost          Float
  files         String[]
  temperature   Float?
  pulse         Int?
  respiration   Int?
  weight        Float?
  anesthesia    String?
  complications String?
  status        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  pet    Pet    @relation(fields: [petId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([petId])
  @@index([clinicId])
  @@index([visitDate])
  @@index([petId, visitDate]) // Составной индекс для истории визитов питомца
}

model Service {
  id                Int      @id @default(autoincrement())
  name              String
  description       String
  recomendation     String
  price             Int
  duration          Int
  category          String
  isEmergency       Boolean  @default(false) @map("is_emergency")
  preparation       String?
  recoveryTime      String?  @map("recovery_time")
  contraindications String?
  successRate       Float?   @map("success_rate")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  clinicId          Int      @map("clinic_id")

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  payments        Payment[]
  paymentSessions PaymentSession[]
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User[]
}

model Notification {
  id               Int              @id @default(autoincrement())
  name             String
  description      String
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  expiriedAt       DateTime?        @map("expiried_at")
  type             NotificationType
  isCompleted      Boolean          @default(false) @map("is_completed")
  location         String?
  repeatPattern    String?          @map("repeat_pattern")
  priority         Int?
  attachmentUrl    String?          @map("attachment_url")
  isConfirmed      Boolean          @default(false) @map("is_confirmed")
  confirmationDate DateTime?        @map("confirmation_date")
  userId           Int              @map("user_id")

  user              User                @relation(fields: [userId], references: [id])
  petOnNotification PetOnNotification[]

  @@index([userId])
  @@index([type])
  @@index([isCompleted])
  @@index([userId, isCompleted]) // Составной индекс для фильтрации по пользователю и статусу
  @@index([expiriedAt])
}

enum NotificationType {
  HIGH
  MEDIUM
  LOW
}

model PetOnNotification {
  pet            Pet          @relation(fields: [petId], references: [id])
  petId          Int          @map("pet_id")
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId Int          @map("notification_id")
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  assignedBy     String       @map("assigned_by")

  @@id([petId, notificationId])
}

model Medication {
  id          Int       @id @default(autoincrement())
  name        String
  dosage      String
  frequency   String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?
  petId       Int       @map("pet_id")

  pet       Pet      @relation(fields: [petId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([petId])
  @@index([startDate])
  @@index([endDate])
}

model Vaccination {
  id          Int       @id @default(autoincrement())
  name        String
  date        DateTime
  nextDate    DateTime? @map("next_date")
  clinicId    Int?      @map("clinic_id")
  petId       Int       @map("pet_id")
  description String?
  files       String[]

  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  pet       Pet      @relation(fields: [petId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([petId])
  @@index([date])
  @@index([petId, date]) // Составной индекс для истории вакцинаций питомца
}

model PetPhoto {
  id        Int     @id @default(autoincrement())
  url       String
  petId     Int     @map("pet_id")
  isPrimary Boolean @default(false) @map("is_primary")

  pet       Pet      @relation(fields: [petId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model HealthMetric {
  id         Int      @id @default(autoincrement())
  petId      Int      @map("pet_id")
  metricType String   @map("metric_type")
  value      Float
  measuredAt DateTime @default(now()) @map("measured_at")
  notes      String?

  pet Pet @relation(fields: [petId], references: [id])
}

model GroomingRecord {
  id          Int       @id @default(autoincrement())
  petId       Int       @map("pet_id")
  serviceType String    @map("service_type")
  status      String?
  date        DateTime
  nextDate    DateTime? @map("next_date")
  groomerName String?   @map("groomer_name")
  notes       String?
  cost        Float?

  pet Pet @relation(fields: [petId], references: [id])
}

model StaffMember {
  id        Int     @id @default(autoincrement())
  clinicId  Int     @map("clinic_id")
  name      String
  position  String
  specialty String?
  phone     String?
  email     String?
  isActive  Boolean @default(true) @map("is_active")

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model Payment {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  serviceId     Int?     @map("service_id")
  amount        Float
  paymentDate   DateTime @default(now()) @map("payment_date")
  method        String
  status        String   @default("completed")
  invoiceNumber String?  @map("invoice_number")

  user           User            @relation(fields: [userId], references: [id])
  service        Service?        @relation(fields: [serviceId], references: [id])
  paymentSession PaymentSession?

  @@index([userId])
  @@index([status])
  @@index([paymentDate])
  @@index([userId, status]) // Составной индекс для истории транзакций пользователя
}

model PaymentSession {
  id             String               @id @default(uuid())
  userId         Int                  @map("user_id")
  amount         Float
  currency       String               @default("RUB")
  description    String?
  status         PaymentSessionStatus @default(PENDING)
  serviceId      Int?                 @map("service_id")
  serviceType    String?              @map("service_type") // veterinary, grooming, boarding, charity, subscription
  metadata       Json? // Дополнительные данные (petId, clinicId, appointmentDate и т.д.)
  expiresAt      DateTime             @map("expires_at")
  paymentMethods String[]             @map("payment_methods") // ["card", "apple_pay", "google_pay"]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  paidAt         DateTime?            @map("paid_at")
  paymentId      Int?                 @unique @map("payment_id")

  user    User     @relation(fields: [userId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([serviceType])
}

enum PaymentSessionStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  clinicId  Int?     @map("clinic_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  clinic Clinic? @relation(fields: [clinicId], references: [id])
}

model PetBoarding {
  id             Int      @id @default(autoincrement())
  name           String
  description    String
  address        String
  phone          String
  email          String
  website        String?
  geoCoordinates String?  @map("geo_coordinates")
  photos         String[]
  rating         Float?
  pricePerDay    Float    @map("price_per_day")
  capacity       Int
  availableSpots Int      @map("available_spots")
  amenities      String[]
  rules          String[]
  checkInTime    String   @map("check_in_time")
  checkOutTime   String   @map("check_out_time")
  isActive       Boolean  @default(true) @map("is_active")
  userId         Int      @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id])
  bookings PetBoardingBooking[]
  reviews  PetBoardingReview[]
  staff    PetBoardingStaff[]
}

model PetBoardingBooking {
  id              Int           @id @default(autoincrement())
  petId           Int           @map("pet_id")
  boardingId      Int           @map("boarding_id")
  startDate       DateTime      @map("start_date")
  endDate         DateTime      @map("end_date")
  status          BookingStatus @default(PENDING)
  specialRequests String?       @map("special_requests")
  totalPrice      Float         @map("total_price")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  userId          Int           @map("user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  pet               Pet                  @relation(fields: [petId], references: [id])
  boarding          PetBoarding          @relation(fields: [boardingId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  payments          PetBoardingPayment[]
  petBoardingReview PetBoardingReview[]

  @@index([userId])
  @@index([petId])
  @@index([boardingId])
  @@index([status])
  @@index([startDate, endDate]) // Для поиска по датам
}

model PetBoardingPayment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @map("booking_id")
  amount        Float
  paymentDate   DateTime      @default(now()) @map("payment_date")
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String?       @map("transaction_id")
  status        PaymentStatus
  notes         String?

  booking PetBoardingBooking @relation(fields: [bookingId], references: [id])
}

model PetBoardingReview {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  rating    Int
  comment   String?
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  booking       PetBoardingBooking @relation(fields: [bookingId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  petBoarding   PetBoarding?       @relation(fields: [petBoardingId], references: [id])
  petBoardingId Int?
}

model PetBoardingStaff {
  id         Int     @id @default(autoincrement())
  boardingId Int     @map("boarding_id")
  name       String
  position   String
  phone      String
  email      String
  isActive   Boolean @default(true) @map("is_active")

  boarding PetBoarding @relation(fields: [boardingId], references: [id])
}

model PetJournalEntry {
  id        Int      @id @default(autoincrement())
  petId     Int      @map("pet_id")
  title     String
  content   String
  mediaUrls String[] @map("media_urls") // фото/видео
  mood      String? // "игривый", "сонный" и т.п.
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pet Pet @relation(fields: [petId], references: [id])
}

model CommunityPost {
  id        Int       @id @default(autoincrement())
  authorId  Int?      @map("author_id") // null = приют или система
  shelterId Int?      @map("shelter_id") // если от приюта
  title     String
  content   String
  mediaUrls String[]  @map("media_urls")
  postType  PostType  @default(ANNOUNCEMENT) @map("post_type")
  isPinned  Boolean   @default(false) @map("is_pinned")
  location  String?
  eventDate DateTime? @map("event_date") // если событие
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  author             User?                @relation(fields: [authorId], references: [id])
  shelter            Shelter?             @relation(fields: [shelterId], references: [id])
  likes              PostLike[]
  comments           PostComment[]
  eventParticipation EventParticipation[]

  @@index([authorId])
  @@index([shelterId])
  @@index([postType])
  @@index([createdAt])
  @@index([isPinned, createdAt]) // Для сортировки закрепленных постов
}

model Shelter {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  address          String
  phone            String
  email            String?
  website          String?
  geoCoordinates   String?  @map("geo_coordinates")
  photos           String[]
  registrationDate DateTime @default(now()) @map("registration_date")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ownerId          Int               @map("owner_id")
  owner            User              @relation(fields: [ownerId], references: [id])
  posts            CommunityPost[]
  animals          ShelterAnimal[]
  adoptionRequests AdoptionRequest[]
  donations        Donation[]

  @@index([ownerId])
  @@index([isActive])
}

model ShelterAnimal {
  id           Int       @id @default(autoincrement())
  shelterId    Int       @map("shelter_id")
  name         String
  animalTypeId Int       @map("animal_type_id")
  breedId      Int?
  gender       PetGender
  ageEstimate  Int? // в месяцах
  description  String
  isAdopted    Boolean   @default(false) @map("is_adopted")
  adoptionDate DateTime? @map("adoption_date")
  photos       String[]
  specialNeeds String? // "нужен дом без детей"
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shelter          Shelter           @relation(fields: [shelterId], references: [id])
  animalType       AnimalType        @relation(fields: [animalTypeId], references: [id])
  breed            AnimalBreed?      @relation(fields: [breedId], references: [id])
  adoptionRequests AdoptionRequest[]

  @@index([shelterId])
  @@index([isAdopted])
}

model PostLike {
  id      Int      @id @default(autoincrement())
  postId  Int      @map("post_id")
  userId  Int      @map("user_id")
  likedAt DateTime @default(now()) @map("liked_at")

  post CommunityPost @relation(fields: [postId], references: [id])
  user User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String
  parentId  Int?     @map("parent_id") // для ответов
  createdAt DateTime @default(now()) @map("created_at")

  post    CommunityPost @relation(fields: [postId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies PostComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model EventParticipation {
  id       Int                 @id @default(autoincrement())
  postId   Int                 @map("post_id") // ссылка на CommunityPost с типом EVENT
  userId   Int                 @map("user_id")
  petId    Int?                @map("pet_id") // какой питомец участвует
  status   ParticipationStatus @default(CONFIRMED)
  joinedAt DateTime            @default(now()) @map("joined_at")

  post CommunityPost @relation(fields: [postId], references: [id])
  user User          @relation(fields: [userId], references: [id])
  pet  Pet?          @relation(fields: [petId], references: [id])

  @@unique([postId, userId, petId])
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PostType {
  ANNOUNCEMENT // объявление приюта
  EVENT // событие: прогулка, конкурс
  BLOG // личный пост владельца
  ADOPTION // "заберите котика"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

model AdoptionRequest {
  id                 Int            @id @default(autoincrement())
  shelterId          Int            @map("shelter_id")
  animalId           Int            @map("animal_id")
  userId             Int            @map("user_id")
  status             AdoptionStatus @default(PENDING)
  contactPhone       String         @map("contact_phone")
  address            String
  adoptionReason     String?        @map("adoption_reason")
  previousExperience Boolean        @default(false) @map("previous_experience")
  agreementAccepted  Boolean        @default(false) @map("agreement_accepted")
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  reviewedAt         DateTime?      @map("reviewed_at")
  reviewedBy         Int?           @map("reviewed_by")

  shelter Shelter       @relation(fields: [shelterId], references: [id])
  animal  ShelterAnimal @relation(fields: [animalId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@unique([animalId, userId]) // Один пользователь может подать только одну заявку на одно животное
  @@index([shelterId])
  @@index([animalId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum AdoptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Donation {
  id               Int            @id @default(autoincrement())
  shelterId        Int            @map("shelter_id")
  userId           Int?           @map("user_id") // null для анонимных пожертвований
  amount           Float
  currency         String         @default("RUB")
  message          String?
  anonymous        Boolean        @default(false)
  recurring        Boolean        @default(false)
  status           DonationStatus @default(PENDING)
  paymentSessionId String?        @map("payment_session_id")
  transactionId    String?        @map("transaction_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  paidAt           DateTime?      @map("paid_at")

  shelter Shelter @relation(fields: [shelterId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([shelterId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
