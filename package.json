{
  "name": "pet-care-backend",
  "version": "1.0.0",
  "description": "Backend API for Pet Care Management System - NestJS application with PostgreSQL, Redis, and comprehensive monitoring",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "nestjs",
    "pet-care",
    "api",
    "backend",
    "typescript",
    "prisma",
    "postgresql",
    "redis",
    "monitoring"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node seeder/seed.ts",
    "seed:small": "SEED_USERS=5 SEED_CLINICS=3 SEED_BOARDINGS=3 npm run seed",
    "seed:large": "SEED_USERS=50 SEED_CLINICS=20 SEED_BOARDINGS=15 npm run seed",
    "docker:build": "docker build -t pet-care-backend .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs-mcp/server": "^0.3.0",
    "@nestjs-modules/mailer": "2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "11.1.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.8",
    "@nestjs/jwt": "10.0.3",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "9.0.3",
    "@nestjs/platform-express": "11.1.8",
    "@nestjs/serve-static": "5.0.4",
    "@nestjs/swagger": "^11.2.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "4.14.0",
    "@types/helmet": "^0.0.48",
    "@types/joi": "^17.2.2",
    "argon2": "0.30.3",
    "cache-manager": "^7.2.5",
    "cache-manager-ioredis-yet": "^2.1.2",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "cross-env": "7.0.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.32.0",
    "joi": "^18.0.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "6.9.2",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "pug": "3.0.2",
    "redis": "^5.9.0",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.2.0",
    "stripe": "^17.3.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "8.0.0",
    "@nestjs/cli": "9.0.0",
    "@nestjs/schematics": "9.0.0",
    "@nestjs/testing": "9.0.0",
    "@types/express": "4.17.13",
    "@types/jest": "29.5.0",
    "@types/multer": "1.4.7",
    "@types/node": "^20.19.25",
    "@types/supertest": "2.0.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.0.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.5.0",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "source-map-support": "0.5.20",
    "supertest": "6.1.3",
    "ts-jest": "29.0.5",
    "ts-loader": "9.2.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": ""
}
